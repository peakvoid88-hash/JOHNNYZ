  <script>

    const homeView = document.getElementById('homeView');
    const menuView = document.getElementById('menuView');

    function showView(view, target) {
      const showMenu = view === 'menu';
      homeView.hidden = showMenu;
      menuView.hidden = !showMenu;
      document.title = showMenu ? 'Menu — JOHNNYZ. | EAT. PLAY. CONNECT.' : 'JOHNNYZ. — EAT. PLAY. CONNECT.';
      if (showMenu) {
        window.scrollTo({ top: 0, behavior: 'auto' });
      } else if (target) {
        requestAnimationFrame(() => {
          const el = document.querySelector(target);
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    document.querySelectorAll('[data-view="menu"]').forEach(link => {
      link.addEventListener('click', event => {
        event.preventDefault();
        showView('menu');
        history.replaceState(null, '', '#menu-page');
      });
    });
    document.querySelectorAll('[data-view="home"]').forEach(link => {
      link.addEventListener('click', event => {
        event.preventDefault();
        showView('home');
        history.replaceState(null, '', '#home');
      });
    });
    menuView.querySelectorAll('.menu-jump a').forEach(link => {
      link.addEventListener('click', event => {
        event.preventDefault();
        const target = link.getAttribute('href');
        const el = document.querySelector(target);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    document.querySelectorAll('#navLinks a[href^="#"]:not([data-view])').forEach(link => {
      link.addEventListener('click', event => {
        if (!homeView.hidden) return;
        event.preventDefault();
        const target = link.getAttribute('href');
        showView('home', target);
        history.replaceState(null, '', target);
      });
    });
    if (location.hash === '#menu-page') showView('menu');

    const toggle = document.getElementById('menuToggle');
    const links = document.getElementById('navLinks');
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      toggle.textContent = open ? '×' : '☰';
    });
    links.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      links.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation');
      toggle.textContent = '☰';
    }));
    const revealItems = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px 40px 0px' });
      revealItems.forEach(el => observer.observe(el));
    } else {
      revealItems.forEach(el => el.classList.add('visible'));
    }

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && links.classList.contains('open')) {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation');
        toggle.textContent = '☰';
        toggle.focus();
      }
    });
  </script>
  <button type="button" class="cart-bar" id="cartBar" hidden><span class="n" id="cbN">0</span><span>View order</span><span id="cbT"></span></button>

  <div class="ck-overlay" id="ckModal" role="dialog" aria-modal="true" aria-labelledby="ckTitle" hidden>
    <div class="ck-panel">
      <div class="ck-head"><div><div class="ck-step" id="ckStep"></div><h2 id="ckTitle"></h2></div><button type="button" class="ck-x" id="ckClose" aria-label="Close">×</button></div>
      <div id="ck1">
        <div id="ckList"></div>
        <div class="ck-sum"><span id="ck1n"></span><strong id="ck1t"></strong></div>
        <div class="ck-btns"><button type="button" class="button light" id="ckMore">+ Add more</button><button type="button" class="button" id="ckNext">Continue →</button></div>
      </div>
      <div id="ck2" hidden>
        <p class="ck-lead">Enter your contact details so JOHNNYZ. can personalise your bill and prepare your meal.</p>
        <label class="ck-lbl" for="ckName">Your full name *</label>
        <input class="ck-in" id="ckName" autocomplete="name" placeholder="e.g. Ruwan Perera">
        <label class="ck-lbl" for="ckPhone">Phone number (WhatsApp) *</label>
        <input class="ck-in" id="ckPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="e.g. 076 462 3406 or 077 123 4567">
        <span class="ck-lbl" id="ckTypeLbl">Order type</span>
        <div class="ck-types" role="radiogroup" aria-labelledby="ckTypeLbl">
          <button type="button" class="ck-type" role="radio" aria-checked="true" data-type="Pickup">Pickup</button>
          <button type="button" class="ck-type" role="radio" aria-checked="false" data-type="Dine-In">Dine-In</button>
          <button type="button" class="ck-type" role="radio" aria-checked="false" data-type="Delivery">Delivery</button>
        </div>
        <div id="ckAddrWrap" hidden><label class="ck-lbl" for="ckAddr">Delivery address *</label><textarea class="ck-in" id="ckAddr" placeholder="House no., street, area"></textarea></div>
        <label class="ck-lbl" for="ckNotes">Special notes or requests (optional)</label>
        <textarea class="ck-in" id="ckNotes" placeholder="e.g. Extra spicy, pack carefully..."></textarea>
        <div class="ck-err" id="ckErr" role="alert"></div>
        <div class="ck-sum"><span id="ck2n"></span><strong id="ck2t"></strong></div>
        <div class="ck-btns"><button type="button" class="button light" id="ckBack">Back</button><button type="button" class="button" id="ckGo">Print bill &amp; confirm</button></div>
      </div>
    </div>
  </div>

  <div class="ck-overlay" id="rcModal" role="dialog" aria-modal="true" aria-label="Your bill" hidden>
    <div class="rc-wrap">
      <div class="rc-machine" id="rcMachine"><div class="rc-top"><span class="rc-brand">JZ-PRINT 80</span><span class="rc-led"></span></div><div class="rc-lcd" id="rcLcd">PRINTING…</div><div class="rc-slot"></div></div>
      <div class="rc-feed" id="rcFeed"><div class="rc-paper" id="rcPaper"></div></div>
      <div class="rc-actions">
        <a class="button rc-wa" id="rcWa" href="#" target="_blank" rel="noopener">Send order on WhatsApp ↗</a>
        <button type="button" class="button light" id="rcPrint">Print bill</button>
        <button type="button" class="button light" id="rcDone">Done</button>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var WA_NUMBER = '94764623406'; // restaurant WhatsApp: country code + number, no "+" or spaces
    var $ = function (id) { return document.getElementById(id); };
    var menuView = $('menuView');
    var items = [], cart = {}, type = 'Pickup', timer;
    var fmt = function (n) { return 'Rs. ' + n.toLocaleString('en-US'); };
    var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };

    menuView.querySelectorAll('.menu-item').forEach(function (el) {
      var priceEl = el.querySelector('.menu-item-price'), nameEl = el.querySelector('.menu-item-name');
      if (!priceEl || !nameEl) return;
      var price = parseInt(priceEl.textContent.replace(/[^\d]/g, ''), 10);
      if (!price) return;
      var buy = document.createElement('div'), ctl = document.createElement('div');
      buy.className = 'mi-buy';
      priceEl.replaceWith(buy); buy.appendChild(priceEl); buy.appendChild(ctl);
      var idx = items.push({ name: nameEl.textContent.trim(), price: price, ctl: ctl }) - 1;
      ctl.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) change(idx, +b.dataset.d); });
    });

    function lines() { return Object.keys(cart).map(function (i) { return { name: items[i].name, price: items[i].price, qty: cart[i] }; }); }
    function totals() { var c = 0, t = 0; lines().forEach(function (l) { c += l.qty; t += l.qty * l.price; }); return { c: c, t: t }; }
    function change(i, d) { cart[i] = (cart[i] || 0) + d; if (cart[i] <= 0) delete cart[i]; render(); }
    function stepper(i) { return '<div class="mi-step"><button type="button" data-d="-1" aria-label="Remove one">−</button><b>' + cart[i] + '</b><button type="button" data-d="1" aria-label="Add one">+</button></div>'; }

    function render() {
      items.forEach(function (it, i) { it.ctl.innerHTML = cart[i] ? stepper(i) : '<button type="button" class="mi-add" data-d="1">+ Add</button>'; });
      var s = totals();
      $('cbN').textContent = s.c; $('cbT').textContent = fmt(s.t);
      $('cartBar').hidden = !(s.c && !menuView.hidden && $('ckModal').hidden && $('rcModal').hidden);
      var sum = s.c + (s.c === 1 ? ' item' : ' items') + ' selected';
      $('ck1n').textContent = $('ck2n').textContent = sum;
      $('ck1t').textContent = $('ck2t').textContent = 'Total: ' + fmt(s.t);
      $('ckNext').disabled = !s.c;
      $('ckList').innerHTML = s.c ? Object.keys(cart).map(function (i) {
        return '<div class="ck-line" data-i="' + i + '"><span class="nm">' + esc(items[i].name) + '</span><span class="pr">' + fmt(items[i].price * cart[i]) + '</span>' + stepper(i) + '<button type="button" class="rm" data-d="-999">Remove</button></div>';
      }).join('') : '<p class="ck-empty">Your cart is empty. Add something tasty from the menu.</p>';
    }
    $('ckList').addEventListener('click', function (e) { var b = e.target.closest('button'), l = e.target.closest('.ck-line'); if (b && l) change(+l.dataset.i, +b.dataset.d); });
    new MutationObserver(render).observe(menuView, { attributes: true, attributeFilter: ['hidden'] });

    function lock() { document.body.style.overflow = ($('ckModal').hidden && $('rcModal').hidden) ? '' : 'hidden'; }
    function step(n) {
      $('ck1').hidden = n !== 1; $('ck2').hidden = n !== 2;
      $('ckStep').textContent = n === 1 ? 'Step 1 of 2 · Review your order' : 'Step 2 of 2 · Bill & confirmation';
      $('ckTitle').textContent = n === 1 ? 'Your order' : 'Almost ready';
      $('ckErr').textContent = '';
      if (n === 2) $('ckName').focus();
    }
    function openCk() { render(); step(1); $('ckModal').hidden = false; lock(); render(); }
    function closeCk() { $('ckModal').hidden = true; lock(); render(); }
    $('cartBar').addEventListener('click', openCk);
    $('ckClose').addEventListener('click', closeCk);
    $('ckMore').addEventListener('click', closeCk);
    $('ckNext').addEventListener('click', function () { if (totals().c) step(2); });
    $('ckBack').addEventListener('click', function () { step(1); });
    document.querySelectorAll('.ck-type').forEach(function (b) {
      b.addEventListener('click', function () {
        type = b.dataset.type;
        document.querySelectorAll('.ck-type').forEach(function (x) { x.setAttribute('aria-checked', String(x === b)); });
        $('ckAddrWrap').hidden = type !== 'Delivery';
      });
    });

    function nextId() {
      try { var n = (parseInt(localStorage.getItem('jz_order_no'), 10) || 1000) + 1; localStorage.setItem('jz_order_no', n); return 'JZ-' + n; }
      catch (e) { return 'JZ-' + (1000 + Math.floor(Math.random() * 9000)); }
    }
    function waText(o) {
      var L = ['*JOHNNYZ. — New Order*', 'Order: ' + o.id, 'Type: ' + o.type, 'Name: ' + o.name, 'Phone: ' + o.phone];
      if (o.type === 'Delivery') L.push('Address: ' + o.addr);
      L.push('', '*Items*');
      o.lines.forEach(function (l) { L.push(l.qty + ' x ' + l.name + ' — ' + fmt(l.qty * l.price)); });
      L.push('', '*Total: ' + fmt(o.total) + '*');
      if (o.notes) L.push('', 'Notes: ' + o.notes);
      return L.join('\n');
    }
    function receipt(o) {
      var d = o.date, ds = d.toLocaleDateString('en-GB') + '  ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      var row = function (a, b, c) { return '<div class="rc-row ' + (c || '') + '"><span>' + a + '</span><span>' + b + '</span></div>'; };
      return '<div class="rc-c rc-logo">JOHNNYZ.</div><div class="rc-c rc-tag">EAT. PLAY. CONNECT.</div>' +
        '<div class="rc-c rc-sm">273 Galle Road, Dehiwala-Mount Lavinia<br>Tel +94 76 462 3406</div><div class="rc-hr"></div>' +
        row('Order', '<b>' + o.id + '</b>') + row('Date', ds) + row('Type', '<b>' + o.type + '</b>') + row('Name', esc(o.name)) + row('Phone', esc(o.phone)) +
        (o.type === 'Delivery' ? '<div class="rc-note">Deliver to: ' + esc(o.addr) + '</div>' : '') +
        '<div class="rc-hr"></div>' + row('ITEM', 'AMOUNT', 'rc-h') +
        o.lines.map(function (l) { return row(l.qty + ' x ' + esc(l.name), fmt(l.qty * l.price)); }).join('') +
        '<div class="rc-hr"></div>' + row('TOTAL', fmt(o.total), 'rc-t') +
        (o.notes ? '<div class="rc-note">Notes: ' + esc(o.notes) + '</div>' : '') +
        '<div class="rc-hr"></div><div class="rc-c">*** THANK YOU ***</div><div class="rc-c rc-sm">Come hungry. Bring your people.</div><div class="rc-bar"></div>';
    }

    $('ckGo').addEventListener('click', function () {
      var name = $('ckName').value.trim(), phone = $('ckPhone').value.trim(), addr = $('ckAddr').value.trim(), digits = phone.replace(/\D/g, ''), err = '';
      if (!totals().c) err = 'Your cart is empty.';
      else if (name.length < 2) err = 'Please enter your full name.';
      else if (digits.length < 9 || digits.length > 15) err = 'Please enter a valid WhatsApp phone number.';
      else if (type === 'Delivery' && !addr) err = 'Please enter your delivery address.';
      $('ckErr').textContent = err;
      if (err) return;
      var o = { id: nextId(), date: new Date(), name: name, phone: phone, type: type, addr: addr, notes: $('ckNotes').value.trim(), lines: lines(), total: totals().t };
      var url = 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(waText(o));
      $('rcWa').href = url;
      $('rcPaper').innerHTML = receipt(o);
      var paper = $('rcPaper'), feed = $('rcFeed'), mach = $('rcMachine');
      paper.style.animation = 'none'; void paper.offsetWidth; paper.style.animation = '';
      feed.classList.remove('done'); mach.classList.remove('done'); $('rcLcd').textContent = 'PRINTING…';
      $('ckModal').hidden = true; $('rcModal').hidden = false; lock();
      clearTimeout(timer);
      timer = setTimeout(function () { feed.classList.add('done'); mach.classList.add('done'); $('rcLcd').textContent = 'ORDER READY ✓'; }, 3000);
      cart = {}; render();
    });
    $('rcPrint').addEventListener('click', function () { window.print(); });
    $('rcDone').addEventListener('click', function () { $('rcModal').hidden = true; lock(); render(); });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (!$('rcModal').hidden) $('rcDone').click(); else if (!$('ckModal').hidden) closeCk();
    });
    render();
  })();
  </script>
</body>
</html>
